rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Una agenda por familia. Solo quien conoce el código (16 caracteres al azar)
    // puede leerla o cambiarla. Nadie puede listar todas ni borrarlas.
    match /familias/{codigo} {
      allow get: if codigo.size() == 19;
      allow create, update: if codigo.size() == 19
        && request.resource.data.keys().hasOnly(['data', 'by', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow list, delete: if false;
    }
    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
